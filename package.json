{
  "name": "dsh-agy",
  "version": "0.1.0-beta.2",
  "description": "Community local agy ACP provider for DeepSeek Harness 0.2.2-rc.1",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./compaction": "./dist/compaction.js",
    "./search": "./dist/search.js",
    "./quota": "./dist/quota.js",
    "./client": "./dist/client.js"
  },
  "bin": {
    "dsh-agy": "dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comet9699/dsh-agy.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "acp"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "homepage": "https://github.com/comet9699/dsh-agy#readme",
  "bugs": {
    "url": "https://github.com/comet9699/dsh-agy/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run build && npm run check:package"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.15.0",
    "@types/yauzl": "3.4.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "^5.11.1",
    "typescript": "^5.9.3",
    "undici": "^7.29.1",
    "vitest": "^4.1.11",
    "yauzl": "3.4.0"
  }
}
